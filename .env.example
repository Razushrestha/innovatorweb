# Leave NEXT_PUBLIC_* empty on Vercel so the app uses same-origin
# /api/backend/* proxies (required for HTTPS → HTTP backends).
# Media (images/videos/avatars) are also rewritten to /api/backend/*
# so browsers on HTTPS do not block mixed-content http:// media URLs.

# Optional: direct backend URLs (local HTTP only)
# NEXT_PUBLIC_AUTH_URL=http://36.253.137.34:8010
# NEXT_PUBLIC_PROFILE_URL=http://36.253.137.34:8011
# NEXT_PUBLIC_FEED_URL=http://36.253.137.34:8012
# NEXT_PUBLIC_CHAT_URL=http://36.253.137.34:8014
# NEXT_PUBLIC_SEARCH_URL=http://36.253.137.34:8015

# Server-side proxy targets (used by /api/backend/[service]/...)
AUTH_URL=http://36.253.137.34:8010
PROFILE_URL=http://36.253.137.34:8011
FEED_URL=http://36.253.137.34:8012
CHAT_URL=http://36.253.137.34:8014
SEARCH_URL=http://36.253.137.34:8015

NEXT_PUBLIC_GOOGLE_CLIENT_ID=
